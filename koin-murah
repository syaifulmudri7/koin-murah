<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>TikTok Allocation Flow</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: #000000;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 0;
    }

    .container {
      width: 100%;
      max-width: 420px;
      height: 100vh;
      background: #000000;
      display: flex;
      flex-direction: column;
      position: relative;
      overflow: hidden;
    }

    @media (min-width: 480px) {
      body {
        padding: 20px 10px;
      }
      .container {
        height: 840px;
        max-height: 96vh;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.9);
      }
    }

    /* AREA VIDEO ATAS */
    .stream-header {
      position: relative;
      width: 100%;
      flex: 1;
      background: #000000;
      overflow: hidden;
    }

    .stream-video, .stream-media-img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      pointer-events: none;
      transition: opacity 0.25s ease;
      z-index: 1;
    }

    /* Pemutar YouTube Mengisi Penuh Layar & Tanpa Jeda */
    .yt-stream-frame {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 100%;
      height: 100%;
      transform: translate(-50%, -50%) scale(2.7);
      transform-origin: center center;
      border: none;
      display: none;
      z-index: 2;
      pointer-events: none;
      transition: transform 0.25s ease;
    }

    .yt-stream-frame.active {
      display: block;
    }

    .video-blackout {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: #000000;
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 6;
      color: #6b7280;
      font-size: 13px;
      font-weight: 600;
      flex-direction: column;
      gap: 8px;
    }

    .video-blackout.active {
      display: flex;
    }

    .top-actions {
      position: absolute;
      top: 14px;
      right: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
      z-index: 15;
    }

    .action-circle-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.55);
      border: 1px solid rgba(255, 255, 255, 0.28);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      backdrop-filter: blur(8px);
      transition: transform 0.15s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    .action-circle-btn:active {
      transform: scale(0.92);
      background: rgba(255, 255, 255, 0.15);
    }

    .action-circle-btn svg {
      width: 18px;
      height: 18px;
      stroke-width: 2;
    }

    .action-circle-btn.sound-unmuted {
      border-color: #38bdf8;
      color: #38bdf8;
      box-shadow: 0 0 10px rgba(56, 189, 248, 0.5);
    }

    .action-circle-btn.video-state-off {
      background: rgba(239, 68, 68, 0.25);
      border-color: #ef4444;
      color: #ef4444;
    }

    .action-circle-btn.music-playing {
      border-color: #22c55e;
      color: #22c55e;
      box-shadow: 0 0 12px rgba(34, 197, 94, 0.6);
      animation: pulseMusic 1.4s infinite ease-in-out;
    }

    @keyframes pulseMusic {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.08); }
    }

    .music-status-bar {
      display: none;
      position: absolute;
      top: 60px;
      right: 14px;
      background: rgba(18, 18, 24, 0.9);
      border: 1px solid rgba(34, 197, 94, 0.5);
      padding: 5px 10px;
      border-radius: 20px;
      color: #ffffff;
      font-size: 11px;
      font-weight: 600;
      z-index: 15;
      backdrop-filter: blur(6px);
      align-items: center;
      gap: 6px;
      max-width: 240px;
    }

    .music-status-bar.show {
      display: flex;
    }

    .music-status-text {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      flex: 1;
    }

    .btn-stop-mini {
      color: #fe2c55;
      font-weight: bold;
      cursor: pointer;
      padding: 0 3px;
    }

    /* MODAL */
    .modal-backdrop {
      display: none;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.75);
      z-index: 100;
      backdrop-filter: blur(5px);
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .modal-backdrop.show {
      display: flex;
    }

    .modal-content {
      width: 100%;
      max-width: 360px;
      background: #181920;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 16px;
      padding: 16px;
      color: #ffffff;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding-bottom: 8px;
    }

    .modal-header h3 {
      font-size: 15px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .close-modal-btn {
      color: #8a8b91;
      font-size: 20px;
      cursor: pointer;
      line-height: 1;
      padding: 2px 6px;
    }

    .source-options-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .source-option-card {
      background: #252631;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px;
      padding: 11px 12px;
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s;
    }

    .source-option-card:hover, .source-option-card:active {
      background: #313342;
      border-color: #fe2c55;
    }

    .source-option-card.card-toggle-power {
      background: #201925;
      border-color: rgba(254, 44, 85, 0.35);
    }

    .source-icon {
      font-size: 20px;
    }

    .source-info h4 {
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 2px;
      color: #ffffff;
    }

    .source-info p {
      font-size: 11px;
      color: #9ca3af;
      line-height: 1.2;
    }

    .music-tab-group {
      display: flex;
      background: #0d0e12;
      border-radius: 8px;
      padding: 2px;
    }

    .music-tab-btn {
      flex: 1;
      border: none;
      background: transparent;
      color: #8a8b91;
      padding: 6px;
      font-size: 12px;
      font-weight: 600;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .music-tab-btn.active {
      background: #272832;
      color: #ffffff;
    }

    .tab-content {
      display: none;
      flex-direction: column;
      gap: 10px;
    }

    .tab-content.active {
      display: flex;
    }

    .yt-search-input-wrap {
      display: flex;
      gap: 6px;
    }

    .yt-search-input {
      flex: 1;
      background: #0f1015;
      border: 1px solid #2f303d;
      border-radius: 7px;
      padding: 8px 10px;
      color: #ffffff;
      font-size: 12px;
      outline: none;
    }

    .yt-search-input:focus {
      border-color: #fe2c55;
    }

    .btn-yt-go {
      background: #fe2c55;
      color: #ffffff;
      border: none;
      border-radius: 7px;
      padding: 8px 12px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .yt-scale-pill {
      background: #252630;
      color: #e1e2e6;
      border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 5px 9px;
      border-radius: 6px;
      font-size: 11px;
      cursor: pointer;
      transition: all 0.15s;
    }

    .yt-scale-pill.active {
      background: #fe2c55;
      color: #ffffff;
      border-color: #fe2c55;
      font-weight: 700;
    }

    .yt-presets {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .preset-pill {
      background: #252630;
      color: #e1e2e6;
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 4px 8px;
      border-radius: 14px;
      font-size: 11px;
      cursor: pointer;
      transition: background 0.15s;
    }

    .preset-pill:hover, .preset-pill:active {
      background: #fe2c55;
      color: #ffffff;
    }

    .btn-pick-gallery {
      background: #22c55e;
      color: #ffffff;
      border: none;
      border-radius: 8px;
      padding: 12px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    /* SHEET BAWAH */
    .sheet-card {
      height: 36vh;
      min-height: 295px;
      max-height: 38vh;
      background: #ffffff;
      border-top-left-radius: 16px;
      border-top-right-radius: 16px;
      position: relative;
      z-index: 15;
      display: flex;
      flex-direction: column;
      box-shadow: 0 -3px 16px rgba(0, 0, 0, 0.35);
      flex-shrink: 0;
      overflow: hidden;
    }

    .step {
      display: none;
      flex-direction: column;
      height: 100%;
      padding: 11px 16px 12px;
      justify-content: space-between;
    }

    .step.active {
      display: flex;
    }

    .btn-primary {
      width: 100%;
      padding: 10px 12px;
      background-color: #fe2c55;
      color: #fff;
      border: none;
      border-radius: 7px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      flex-shrink: 0;
      transition: background 0.2s, transform 0.1s;
    }

    .btn-primary:active {
      transform: scale(0.98);
      background-color: #e02449;
    }

    .tiktok-coin {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.15));
    }

    /* STEP 1 */
    .step-1-header h2 {
      font-size: 16px;
      font-weight: 800;
      color: #161823;
      letter-spacing: -0.2px;
    }

    .step-1-header p {
      color: #ea284e;
      font-size: 11px;
      font-weight: 600;
      margin: 1px 0 6px;
    }

    .tier-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
      margin-bottom: 6px;
    }

    .tier-card {
      border: 1.2px solid #eaebed;
      border-radius: 8px;
      padding: 5px 3px;
      text-align: center;
      cursor: pointer;
      transition: all 0.15s ease;
      background: #f7f8f9;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 42px;
    }

    .tier-card.selected {
      border: 1.5px solid #fec400;
      background-color: #ffffff;
      box-shadow: 0 0 10px rgba(254, 196, 0, 0.4);
    }

    .tier-amount {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13.5px;
      font-weight: 800;
      color: #161823;
      gap: 4px;
      margin-bottom: 1px;
    }

    .tier-amount.custom-text {
      font-size: 12px;
    }

    .tier-price {
      font-size: 10.5px;
      color: #7b7d85;
      font-weight: 600;
      line-height: 1.1;
    }

    .input-wrapper {
      position: relative;
      margin-bottom: 4px;
    }

    .input-icon {
      position: absolute;
      left: 10px;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .username-input {
      width: 100%;
      padding: 6px 30px 6px 32px;
      border-radius: 6px;
      border: 1px solid #e7e8ea;
      background: #f1f2f4;
      font-size: 12px;
      color: #161823;
      outline: none;
      height: 31px;
    }

    .username-input::placeholder {
      color: #8a8b91;
    }

    .username-input:focus {
      border-color: #161823;
      background: #ffffff;
    }

    .search-spinner {
      display: none;
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      width: 13px;
      height: 13px;
      border: 2px solid #ddd;
      border-top-color: #fe2c55;
      border-radius: 50%;
      animation: spin 0.65s linear infinite;
    }

    .search-spinner.show {
      display: block;
    }

    .helper-text {
      font-size: 10px;
      color: #8a8b91;
      margin-bottom: 3px;
      line-height: 1.2;
    }

    .status-badge {
      display: flex;
      align-items: center;
      font-size: 10.5px;
      color: #606266;
      margin-bottom: 6px;
    }

    .status-badge::before {
      content: "✓";
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 12px;
      height: 12px;
      background-color: #ffb800;
      color: white;
      font-size: 8px;
      border-radius: 50%;
      margin-right: 5px;
      font-weight: bold;
    }

    /* STEP CUSTOM */
    .custom-label-top {
      font-size: 11px;
      color: #8a8b91;
      margin-bottom: 3px;
      font-weight: 500;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .custom-back-btn {
      font-size: 11px;
      color: #fe2c55;
      cursor: pointer;
      font-weight: 600;
    }

    .custom-amount-box {
      border: 1px solid #e5e6e8;
      border-radius: 7px;
      background: #ffffff;
      padding: 6px 10px;
      display: flex;
      align-items: center;
      gap: 7px;
      margin-bottom: 3px;
    }

    .custom-amount-value {
      font-size: 17px;
      font-weight: 800;
      color: #161823;
    }

    .custom-status-text {
      font-size: 10px;
      color: #8a8b91;
      margin-bottom: 6px;
    }

    .custom-keypad-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border: 1px solid #eaebed;
      border-radius: 7px;
      overflow: hidden;
      margin-bottom: 8px;
    }

    .key-btn {
      border: none;
      background: #ffffff;
      border-right: 1px solid #eaebed;
      border-bottom: 1px solid #eaebed;
      padding: 6.5px 0;
      font-size: 15px;
      font-weight: 700;
      color: #161823;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.1s;
    }

    .key-btn:nth-child(3n) {
      border-right: none;
    }

    .key-btn:nth-child(n+10) {
      border-bottom: none;
    }

    .key-btn:active {
      background: #f1f2f4;
    }

    .backspace-icon {
      width: 17px;
      height: 17px;
    }

    /* STEP 2 */
    .secure-banner {
      background-color: #091524;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 6.5px 10px;
      font-size: 12px;
      font-weight: 600;
      gap: 6px;
      border-radius: 5px;
      margin-bottom: 7px;
    }

    .shield-icon {
      width: 14px;
      height: 14px;
      fill: #85d7ff;
    }

    .profile-summary {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 6px;
    }

    .profile-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
      background: #111;
      border: 1px solid #e1e2e4;
      flex-shrink: 0;
    }

    .profile-info {
      min-width: 0;
      flex: 1;
    }

    .profile-info h3 {
      font-size: 14px;
      font-weight: 800;
      color: #161823;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.2;
    }

    .profile-info p {
      font-size: 11px;
      color: #8a8b91;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .data-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 5.5px 0;
      border-bottom: 1px solid #f1f1f2;
      font-size: 12.5px;
    }

    .data-label {
      color: #76777e;
      font-weight: 500;
    }

    .data-val {
      font-weight: 700;
      color: #161823;
      display: flex;
      align-items: center;
    }

    .radio-circle {
      width: 15px;
      height: 15px;
      border: 2px solid #fe2c55;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .radio-circle::after {
      content: "";
      width: 7px;
      height: 7px;
      background: #fe2c55;
      border-radius: 50%;
    }

    /* STEP 3 */
    #step-3 {
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .spinner {
      width: 44px;
      height: 44px;
      border: 3.5px solid #eceef1;
      border-top-color: #fe2c55;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin-bottom: 16px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .loading-text {
      font-size: 17px;
      font-weight: 800;
      color: #161823;
    }

    /* STEP 4 */
    #step-4 {
      text-align: center;
      align-items: center;
    }

    .check-icon-large {
      width: 42px;
      height: 42px;
      stroke: #22c55e;
      margin: 2px 0 4px;
    }

    .success-title {
      font-size: 18px;
      font-weight: 800;
      color: #161823;
      margin-bottom: 4px;
    }

    .assigned-info {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      color: #161823;
      margin-bottom: 3px;
      font-weight: 600;
      gap: 5px;
    }

    .estimated-date {
      color: #ea284e;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .sub-notice {
      color: #7b7d85;
      font-size: 11px;
      line-height: 1.35;
      margin-bottom: 6px;
    }
  </style>
</head>
<body>

  <div class="container">
    
    <!-- HEADER STREAM -->
    <div class="stream-header" id="streamContainer">
      <video class="stream-video" autoplay loop muted playsinline disablePictureInPicture id="manualStreamVideo">
        <source src="video.mp4" type="video/mp4">
        <source src="https://assets.mixkit.co/videos/preview/mixkit-vertical-portrait-of-a-woman-posing-with-colorful-lights-42999-large.mp4" type="video/mp4">
      </video>

      <!-- Frame YouTube -->
      <iframe class="yt-stream-frame" id="ytStreamFrame" src="" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>

      <!-- Overlay Layar Hitam -->
      <div class="video-blackout" id="videoBlackout">
        <span style="font-size: 26px;">📷🚫</span>
        <span>Video Dinonaktifkan</span>
      </div>

      <input type="file" id="galleryInput" accept="video/*,image/*" style="display: none;">
      <input type="file" id="nativeCameraInput" accept="video/*,image/*" capture="environment" style="display: none;">
      <input type="file" id="musicGalleryInput" accept="audio/*,video/*" style="display: none;">
      <audio id="bgAudio" loop playsinline></audio>

      <!-- Notifikasi Mini Status Lagu -->
      <div class="music-status-bar" id="musicStatusBar">
        <span id="statusBarIcon">🎵</span>
        <span class="music-status-text" id="musicPlayingTitle">Memutar Lagu</span>
        <span class="btn-stop-mini" id="btnStopMusicMini" title="Tutup">&#x2715;</span>
      </div>

      <!-- Tombol Aksi Kanan Atas -->
      <div class="top-actions">
        <!-- 1. Fullscreen -->
        <button class="action-circle-btn" id="btnToggleFullscreen" title="Layar Penuh">
          <svg id="iconEnterFullscreen" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" y1="3" x2="14" y2="10"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>
          <svg id="iconExitFullscreen" style="display: none;" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="4 14 10 14 10 20"></polyline><polyline points="20 10 14 10 14 4"></polyline><line x1="14" y1="10" x2="21" y2="3"></line><line x1="3" y1="21" x2="10" y2="14"></line></svg>
        </button>

        <!-- 2. Suara -->
