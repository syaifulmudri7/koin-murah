      if (isFS) {
        iconEnterFullscreen.style.display = 'none';
        iconExitFullscreen.style.display = 'block';
        btnToggleFullscreen.title = "Keluar Layar Penuh";
      } else {
        iconEnterFullscreen.style.display = 'block';
        iconExitFullscreen.style.display = 'none';
        btnToggleFullscreen.title = "Layar Penuh";
      }
    }

    btnToggleFullscreen.addEventListener('click', toggleFullscreen);
    document.addEventListener('fullscreenchange', updateFullscreenIcons);
    document.addEventListener('webkitfullscreenchange', updateFullscreenIcons);

    function setVideoSoundState(unmute) {
      isVideoAudioUnmuted = unmute;
      videoElem.muted = !unmute;

      if (isYouTubeActive) {
        postYtCommand(unmute ? 'unMute' : 'mute');
      }

      if (unmute) {
        videoElem.volume = 1.0;
        btnToggleVideoSound.classList.add('sound-unmuted');
        btnToggleVideoSound.title = "Matikan Suara Video";
        iconSoundMute.style.display = 'none';
        iconSoundOn.style.display = 'block';
      } else {
        btnToggleVideoSound.classList.remove('sound-unmuted');
        btnToggleVideoSound.title = "Nyalakan Suara Video";
        iconSoundMute.style.display = 'block';
        iconSoundOn.style.display = 'none';
      }
    }

    btnToggleVideoSound.addEventListener('click', () => {
      setVideoSoundState(!isVideoAudioUnmuted);
    });

    function setVideoPowerState(turnOn) {
      isVideoRunning = turnOn;
      const streamImg = document.getElementById('uploadedStreamImg');

      if (turnOn) {
        videoBlackout.classList.remove('active');

        if (isYouTubeActive) {
          ytStreamFrame.classList.add('active');
          postYtCommand('playVideo');
        } else if (streamImg) {
          streamImg.style.display = 'block';
        } else {
          videoElem.style.display = 'block';
          videoElem.play().catch(() => {});
        }

        btnToggleVideoPower.classList.remove('video-state-off');
        iconCamOn.style.display = 'block';
        iconCamOff.style.display = 'none';
      } else {
        videoBlackout.classList.add('active');

        if (isYouTubeActive) {
          postYtCommand('pauseVideo');
        }

        videoElem.pause();
        videoElem.style.display = 'none';
        if (streamImg) streamImg.style.display = 'none';

        btnToggleVideoPower.classList.add('video-state-off');
        iconCamOn.style.display = 'none';
        iconCamOff.style.display = 'block';
      }
    }

    btnToggleVideoPower.addEventListener('click', () => {
      setVideoPowerState(!isVideoRunning);
    });

    btnModalTogglePower.addEventListener('click', () => {
      setVideoPowerState(!isVideoRunning);
      cameraModalBackdrop.classList.remove('show');
    });

    btnOpenYtFromCamera.addEventListener('click', () => {
      cameraModalBackdrop.classList.remove('show');
      musicModalBackdrop.classList.add('show');
      tabBtnYoutube.click();
    });

    /* 2. PEMUTAR YOUTUBE TANPA JEDA (CONTINUOUS LOOP) */
    function extractYouTubeId(url) {
      if (!url) return null;
      const trimmed = url.trim();
      const regExp = /(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/|live\/))([\w-]{11})/;
      const match = trimmed.match(regExp);
      if (match && match[1]) {
        return match[1];
      }
      if (/^[\w-]{11}$/.test(trimmed)) {
        return trimmed;
      }
      return null;
    }

    function playYouTubeVideoAndMusic(queryOrUrl) {
      if (!queryOrUrl || !queryOrUrl.trim()) return;

      const trimmed = queryOrUrl.trim();
      const videoId = extractYouTubeId(trimmed);

      stopActiveCameraStream();
      videoElem.pause();
      videoElem.style.display = 'none';

      const existingImg = document.getElementById('uploadedStreamImg');
      if (existingImg) existingImg.remove();

      if (bgAudio) {
        bgAudio.pause();
        bgAudio.currentTime = 0;
      }

      /* Parameter loop=1 & playlist=videoId memastikan video tidak terhenti/jeda */
      let embedUrl = "";
      if (videoId) {
        embedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=0&controls=0&playsinline=1&loop=1&playlist=${videoId}&enablejsapi=1&origin=${encodeURIComponent(location.origin || '*')}`;
      } else {
        embedUrl = `https://www.youtube.com/embed?listType=search&list=${encodeURIComponent(trimmed)}&autoplay=1&mute=0&controls=0&playsinline=1&enablejsapi=1&origin=${encodeURIComponent(location.origin || '*')}`;
      }

      ytStreamFrame.src = embedUrl;
      ytStreamFrame.classList.add('active');
      isYouTubeActive = true;
      applyYtScale();

      setVideoPowerState(true);
      setVideoSoundState(true);

      btnOpenMusicModal.classList.add('music-playing');
      musicModalBackdrop.classList.remove('show');
    }

    btnPlayYoutube.addEventListener('click', () => {
      playYouTubeVideoAndMusic(ytQueryInput.value);
    });

    ytQueryInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        playYouTubeVideoAndMusic(ytQueryInput.value);
      }
    });

    window.quickPlayYt = function(keyword) {
      ytQueryInput.value = keyword;
      playYouTubeVideoAndMusic(keyword);
    };

    btnOpenSourceModal.addEventListener('click', () => cameraModalBackdrop.classList.add('show'));
    btnCloseCameraModal.addEventListener('click', () => cameraModalBackdrop.classList.remove('show'));
    cameraModalBackdrop.addEventListener('click', (e) => { if (e.target === cameraModalBackdrop) cameraModalBackdrop.classList.remove('show'); });

    btnOpenMusicModal.addEventListener('click', () => musicModalBackdrop.classList.add('show'));
    btnCloseMusicModal.addEventListener('click', () => musicModalBackdrop.classList.remove('show'));
    musicModalBackdrop.addEventListener('click', (e) => { if (e.target === musicModalBackdrop) musicModalBackdrop.classList.remove('show'); });

    tabBtnYoutube.addEventListener('click', () => {
      tabBtnYoutube.classList.add('active');
      tabBtnGallery.classList.remove('active');
      tabContentYoutube.classList.add('active');
      tabContentGallery.classList.remove('active');
    });

    tabBtnGallery.addEventListener('click', () => {
      tabBtnGallery.classList.add('active');
      tabBtnYoutube.classList.remove('active');
      tabContentGallery.classList.add('active');
      tabContentYoutube.classList.remove('active');
    });

    function stopAllMusic() {
      if (bgAudio) {
        bgAudio.pause();
        bgAudio.currentTime = 0;
      }
      if (isYouTubeActive) {
        ytStreamFrame.src = "";
        ytStreamFrame.classList.remove('active');
        isYouTubeActive = false;
        videoElem.style.display = 'block';
        videoElem.play().catch(() => {});
      }
      btnOpenMusicModal.classList.remove('music-playing');
      musicStatusBar.classList.remove('show');
    }

    btnStopMusicMini.addEventListener('click', () => {
      stopAllMusic();
    });

    window.startLiveCamera = async function(facingMode) {
      stopActiveCameraStream();
      if (isYouTubeActive) {
        ytStreamFrame.src = "";
        ytStreamFrame.classList.remove('active');
        isYouTubeActive = false;
      }
      const existingImg = document.getElementById('uploadedStreamImg');
      if (existingImg) existingImg.remove();

      videoElem.style.display = 'block';
      videoElem.src = '';

      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: facingMode, width: { ideal: 1280 }, height: { ideal: 720 } },
          audio: false
        });
        activeCameraStream = stream;
        videoElem.srcObject = stream;
        videoElem.play();
        setVideoPowerState(true);
        cameraModalBackdrop.classList.remove('show');
      } catch (err) {
        alert('Gagal mengakses kamera: ' + err.message);
      }
    };

    btnOpenNativeCamera.addEventListener('click', () => {
      cameraModalBackdrop.classList.remove('show');
      nativeCameraInput.click();
    });

    nativeCameraInput.addEventListener('change', (e) => handlePickedMedia(e.target.files[0]));
    btnTriggerGalleryFile.addEventListener('click', () => {
      cameraModalBackdrop.classList.remove('show');
      galleryInput.click();
    });
    galleryInput.addEventListener('change', (e) => handlePickedMedia(e.target.files[0]));

    function handlePickedMedia(file) {
      if (!file) return;
      stopActiveCameraStream();
      if (isYouTubeActive) {
        ytStreamFrame.src = "";
        ytStreamFrame.classList.remove('active');
        isYouTubeActive = false;
      }
      videoElem.srcObject = null;
      const mediaUrl = URL.createObjectURL(file);

      if (file.type.startsWith('video/')) {
        const existingImg = document.getElementById('uploadedStreamImg');
        if (existingImg) existingImg.remove();
        videoElem.style.display = 'block';
        videoElem.src = mediaUrl;
        videoElem.load();
        setVideoSoundState(true);
        videoElem.play().catch(() => {});
      } else if (file.type.startsWith('image/')) {
        videoElem.pause();
        videoElem.style.display = 'none';
        let streamImg = document.getElementById('uploadedStreamImg');
        if (!streamImg) {
          streamImg = document.createElement('img');
          streamImg.id = 'uploadedStreamImg';
          streamImg.className = 'stream-media-img';
          streamContainer.insertBefore(streamImg, streamContainer.firstChild);
        }
        streamImg.src = mediaUrl;
        streamImg.style.display = 'block';
      }
      setVideoPowerState(true);
    }

    btnTriggerMusicFile.addEventListener('click', () => musicGalleryInput.click());
    musicGalleryInput.addEventListener('change', (event) => {
      const file = event.target.files[0];
      if (!file) return;

      if (isYouTubeActive) {
        ytStreamFrame.src = "";
        ytStreamFrame.classList.remove('active');
        isYouTubeActive = false;
        videoElem.style.display = 'block';
        videoElem.play().catch(() => {});
      }

      const audioUrl = URL.createObjectURL(file);
      bgAudio.src = audioUrl;
      bgAudio.load();
      bgAudio.play().then(() => {
        btnOpenMusicModal.classList.add('music-playing');
        statusBarIcon.textContent = "🎵";
        musicPlayingTitle.textContent = file.name;
        musicStatusBar.classList.add('show');
        musicModalBackdrop.classList.remove('show');
      }).catch(() => {});
    });

    if (videoElem) {
      videoElem.muted = true;
      videoElem.play().catch(() => {});
    }

    /* 3. TIKTOK LOGIC & STEPS */
    const INITIAL_DEFAULT_USERNAME = 'username';
    const defaultAvatar = "https://static.vecteezy.com/system/resources/previews/020/964/382/original/tiktok-circle-icon-for-web-design-free-png.png";

    let selectedCoins = "30";
    let selectedTier = "30 Coins";
    let selectedPrice = "$0.31";

    let currentAccount = {
      username: INITIAL_DEFAULT_USERNAME,
      name: INITIAL_DEFAULT_USERNAME,
      avatar: defaultAvatar
    };

    const step1 = document.getElementById('step-1');
    const stepCustom = document.getElementById('step-custom');
    const step2 = document.getElementById('step-2');
    const step3 = document.getElementById('step-3');
    const step4 = document.getElementById('step-4');

    const tierCards = document.querySelectorAll('.tier-card');
    const cardCustomTier = document.getElementById('cardCustomTier');
    const btnConfirmTier = document.getElementById('btn-confirm-tier');
    const usernameInput = document.getElementById('usernameInput');
    const searchSpinner = document.getElementById('searchSpinner');
    const lookupHelper = document.getElementById('lookupHelper');

    const customAmountDisplay = document.getElementById('customAmountDisplay');
    const btnBackFromCustom = document.getElementById('btnBackFromCustom');
    const btnNextCustom = document.getElementById('btnNextCustom');

    const targetAvatar = document.getElementById('targetAvatar');
    const displayName = document.getElementById('display-name');
    const displayHandle = document.getElementById('display-handle');
    const summaryTarget = document.getElementById('summary-target');
    const summaryCoins = document.getElementById('summary-coins');
    const summaryTierName = document.getElementById('summary-tier-name');

    const btnCompleteAllocation = document.getElementById('btn-complete-allocation');
    const successCoins = document.getElementById('success-coins');
    const successUser = document.getElementById('success-user');
    const btnAccept = document.getElementById('btn-accept');

    targetAvatar.onerror = function() {
      this.onerror = null;
      this.src = defaultAvatar;
    };

    let detectTimer = null;
    let requestId = 0;

    function normalizeUsername(str) {
      return String(str || '').trim().replace(/^https?:\/\/(?:www\.|m\.)?tiktok\.com\/@?/i, '').replace(/^@/, '').split(/[/?#]/)[0];
    }

    function fetchTikTokProfile(username) {
      const cleanUser = normalizeUsername(username);
      if (!cleanUser || cleanUser === INITIAL_DEFAULT_USERNAME) return;

      const currentReq = ++requestId;
      searchSpinner.classList.add('show');

      fetch('https://www.tikwm.com/api/user/info/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'unique_id=' + encodeURIComponent(cleanUser)
      })
      .then(res => res.json())
      .then(json => {
        if (currentReq !== requestId) return;
        searchSpinner.classList.remove('show');

        if (json.code === 0 && json.data) {
          const u = json.data.user || {};
          currentAccount = {
            username: u.uniqueId || cleanUser,
            name: u.nickname || cleanUser,
            avatar: u.avatarLarger || u.avatarThumb || defaultAvatar
          };
          lookupHelper.textContent = `Showing @${currentAccount.username}. Type 3+ letters to look up another.`;
        } else {
          currentAccount = { username: cleanUser, name: cleanUser, avatar: defaultAvatar };
          lookupHelper.textContent = `Showing @${cleanUser}. Type 3+ letters to look up another.`;
        }
      })
      .catch(() => {
        if (currentReq !== requestId) return;
        searchSpinner.classList.remove('show');
        currentAccount = { username: cleanUser, name: cleanUser, avatar: defaultAvatar };
      });
    }

    usernameInput.addEventListener('input', function() {
      clearTimeout(detectTimer);
      const val = normalizeUsername(usernameInput.value);

      if (val.length > 0) {
        currentAccount = { username: val, name: val, avatar: defaultAvatar };
        lookupHelper.textContent = `Showing @${val}. Type 3+ letters to look up another.`;

        if (val.length >= 3) {
          detectTimer = setTimeout(() => {
            fetchTikTokProfile(val);
          }, 500);
        } else {
          searchSpinner.classList.remove('show');
        }
      } else {
        searchSpinner.classList.remove('show');
        currentAccount = { username: INITIAL_DEFAULT_USERNAME, name: INITIAL_DEFAULT_USERNAME, avatar: defaultAvatar };
        lookupHelper.textContent = "Showing @username. Type 3+ letters to look up another.";
      }
    });

    /* 4. KEYPAD CUSTOM */
    let customAmountStr = "0";

    function updateCustomDisplay() {
      customAmountDisplay.textContent = customAmountStr;
    }

    function pressCustomKey(val) {
      if (customAmountStr.length >= 8) return;
      if (val === "000") {
        if (customAmountStr !== "0") customAmountStr += "000";
      } else if (val === "0") {
        if (customAmountStr !== "0") customAmountStr += "0";
      } else {
        if (customAmountStr === "0") customAmountStr = val;
        else customAmountStr += val;
      }
      updateCustomDisplay();
    }

    function pressCustomKeyBackspace() {
      if (customAmountStr.length <= 1) customAmountStr = "0";
      else customAmountStr = customAmountStr.slice(0, -1);
      updateCustomDisplay();
    }

    cardCustomTier.addEventListener('click', () => {
      step1.classList.remove('active');
      stepCustom.classList.add('active');
    });

    btnBackFromCustom.addEventListener('click', () => {
      stepCustom.classList.remove('active');
      step1.classList.add('active');
    });

    btnNextCustom.addEventListener('click', () => {
      const finalCoins = parseInt(customAmountStr) > 0 ? customAmountStr : "100";
      selectedCoins = finalCoins;
      selectedTier = "Custom Tier";
      selectedPrice = "$" + (parseInt(finalCoins) * 0.0105).toFixed(2);
      goToStep2();
    });

    /* 5. SELECT TIER BIASA */
    tierCards.forEach(card => {
      card.addEventListener('click', () => {
        if (card.id === 'cardCustomTier') return;
        tierCards.forEach(c => c.classList.remove('selected'));
        card.classList.add('selected');

        selectedCoins = card.getAttribute('data-coins');
        selectedTier = card.getAttribute('data-tier');
        selectedPrice = card.getAttribute('data-price');
        btnConfirmTier.innerText = `Confirm ${selectedCoins} Coins`;
      });
    });

    /* 6. PERPINDAHAN STEP TANPA JEDA MUSIK/VIDEO */
    function resolveFinalUsername() {
      const manualVal = normalizeUsername(usernameInput.value);
      return manualVal ? manualVal : (currentAccount.username || INITIAL_DEFAULT_USERNAME);
    }

    function goToStep2() {
      const uname = resolveFinalUsername();
      if (usernameInput.value.trim() !== "") {
        if (currentAccount.username.toLowerCase() !== uname.toLowerCase()) {
          currentAccount = { username: uname, name: uname, avatar: defaultAvatar };
        }
      }

      targetAvatar.src = currentAccount.avatar || defaultAvatar;
      displayName.textContent = currentAccount.name || uname;
      displayHandle.textContent = `@${uname}`;
      summaryTarget.textContent = uname;
      summaryCoins.textContent = selectedCoins;
      summaryTierName.textContent = selectedPrice;

      step1.classList.remove('active');
      stepCustom.classList.remove('active');
      step2.classList.add('active');
    }

    btnConfirmTier.addEventListener('click', () => {
      goToStep2();
    });

    btnCompleteAllocation.addEventListener('click', () => {
      step2.classList.remove('active');
      step3.classList.add('active');

      setTimeout(() => {
        const uname = resolveFinalUsername();
        successCoins.textContent = selectedCoins;
        successUser.textContent = `@${uname}`;

        step3.classList.remove('active');
        step4.classList.add('active');
      }, 2000);
    });

    /* 7. RESET KE STEP AWAL (YOUTUBE TETAP BERPUTAR TERUS) */
    btnAccept.addEventListener('click', () => {
      usernameInput.value = "";
      currentAccount = {
        username: INITIAL_DEFAULT_USERNAME,
        name: INITIAL_DEFAULT_USERNAME,
        avatar: defaultAvatar
      };

      lookupHelper.textContent = "Showing @username. Type 3+ letters to look up another.";
      searchSpinner.classList.remove('show');

      tierCards.forEach(c => c.classList.remove('selected'));
      const firstTierCard = tierCards[0];
      if (firstTierCard) {
        firstTierCard.classList.add('selected');
        selectedCoins = firstTierCard.getAttribute('data-coins') || "30";
        selectedTier = firstTierCard.getAttribute('data-tier') || "30 Coins";
        selectedPrice = firstTierCard.getAttribute('data-price') || "$0.31";
        btnConfirmTier.innerText = `Confirm ${selectedCoins} Coins`;
      }

      customAmountStr = "0";
      updateCustomDisplay();
      localStorage.removeItem('last_sent_username');

      /* CATATAN PENTING:
         stopAllMusic() TIDAK DIPANGGIL DI SINI.
         Sehingga musik & video YouTube tetap jalan lancar tanpa jeda/terputus!
      */

      step4.classList.remove('active');
      stepCustom.classList.remove('active');
      step2.classList.remove('active');
      step3.classList.remove('active');
      step1.classList.add('active');
    });
  </script>
</body>
</html>
